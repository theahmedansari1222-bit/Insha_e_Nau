---
import Admin from '../../layouts/Admin.astro';
import { dbAdmin } from '../../lib/supabase';
import { gmailLink } from '../../lib/admin';
import { timeAgo } from '../../lib/urdu';

let unseen: any[] = [];
let contacts: any[] = [];
let problem = '';
try {
  const db = dbAdmin();
  const [u, c] = await Promise.all([
    db
      .from('messages')
      .select('id,body,created_at,post_id,posts(title)')
      .eq('sender', 'writer')
      .eq('seen', false)
      .order('created_at', { ascending: false })
      .limit(50),
    db
      .from('contact_messages')
      .select('id,name,email,body,handled,created_at')
      .order('handled', { ascending: true })
      .order('created_at', { ascending: false })
      .limit(100),
  ]);
  if (u.error) throw new Error(u.error.message);
  if (c.error) throw new Error(c.error.message);
  unseen = u.data ?? [];
  contacts = c.data ?? [];
} catch (e) {
  console.error('admin messages:', e);
  problem = 'ڈیٹا بیس سے رابطہ نہیں ہو سکا۔';
}
---
<Admin title="ایڈمن: پیغامات" active="messages">
  <h1 class="nq" style="margin-top: 8px;">پیغامات</h1>
  {problem && <p class="err" role="alert">{problem}</p>}

  <section class="panel">
    <h2>لکھاریوں کے نئے پیغام</h2>
    {unseen.length === 0 && <p class="muted">کوئی نیا پیغام نہیں۔</p>}
    <div class="list" style="margin-block: 8px 0;">
      {unseen.map((m) => (
        <a class="row-card" href={`/admin/post/${m.post_id}`}>
          <span class="top"><span class="tag">{m.posts?.title}</span><span class="muted">{timeAgo(m.created_at)}</span></span>
          <span style="white-space: pre-wrap;">{m.body}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="panel">
    <h2>رابطہ فارم کے پیغام</h2>
    {contacts.length === 0 && <p class="muted">ابھی کوئی پیغام نہیں۔</p>}
    <div class="list" style="margin-block: 8px 0;">
      {contacts.map((m) => (
        <div class="row-card" data-contact={m.id} style={m.handled ? 'opacity: 0.6;' : ''}>
          <span class="top">
            <span class="tag">{m.name || 'نام نہیں'}</span>
            <span class="muted">{timeAgo(m.created_at)}</span>
          </span>
          <span style="white-space: pre-wrap;">{m.body}</span>
          <span class="actions" style="margin-top: 8px;">
            {m.email && (
              <a class="btn" href={gmailLink(m.email, 'انشائے نو: آپ کے پیغام کا جواب', `\n\n— آپ کا پیغام:\n${m.body}`)} target="_blank" rel="noopener">
                جی میل میں جواب
              </a>
            )}
            <button type="button" class="btn" data-done={m.handled ? '0' : '1'}>{m.handled ? 'دوبارہ کھولیں' : 'ہو گیا'}</button>
          </span>
        </div>
      ))}
    </div>
  </section>

  <script>
    document.querySelectorAll<HTMLElement>('[data-contact]').forEach((box) => {
      box.querySelector<HTMLButtonElement>('[data-done]')?.addEventListener('click', async (e) => {
        const btn = e.currentTarget as HTMLButtonElement;
        btn.disabled = true;
        try {
          await fetch('/api/admin/action', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'contact-done', id: Number(box.dataset.contact), handled: btn.dataset.done === '1' }),
          });
          location.reload();
        } catch {
          btn.disabled = false;
        }
      });
    });
  </script>
</Admin>
