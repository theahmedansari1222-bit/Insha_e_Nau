---
interface Props {
  current?: string;
}
const { current = '/' } = Astro.props;
const on = (p: string) => (p === '/' ? current === '/' : current.startsWith(p)) ? 'page' : undefined;
---
<nav class="tabbar" aria-label="موبائل نیویگیشن">
  <a href="/" aria-label="ہوم" aria-current={on('/')}>
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l9-8 9 8v10h-6v-6H9v6H3z"></path></svg>
  </a>
  <a href="/search" aria-label="تلاش" aria-current={on('/search')}>
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4"></path></svg>
  </a>
  <a href="/write" aria-label="تحریر بھیجیں" aria-current={on('/write')}>
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
  </a>
  <a href="/about" aria-label="ہمارے بارے میں" aria-current={on('/about')}>
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 11v5M12 8h.01"></path></svg>
  </a>
</nav>
